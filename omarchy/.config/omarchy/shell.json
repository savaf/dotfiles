{
  "bar": {
    "background": "glassy",
    "layout": {
      "center": [
        {
          "birthYear": 1996,
          "format": "ddd d MMM h:mm AP",
          "formatAlt": "d MMMM 'W'ww yyyy",
          "id": "omarchy.clock",
          "lifeExpectancy": 70,
          "verticalFormat": "HH\n—\nmm"
        }
      ],
      "centerBegin": [
        {
          "id": "omarchy.indicators"
        }
      ],
      "centerEnd": [
        {
          "cities": [
            {
              "name": "Santo Domingo",
              "zone": "America/Santo_Domingo"
            },
            {
              "name": "New Jersey",
              "zone": "America/New_York"
            }
          ],
          "id": "omarchy.elsewhen"
        },
        {
          "id": "omarchy.weather"
        },
        {
          "id": "savaf.media"
        },
        {
          "id": "omarchy.system-update"
        },
        {
          "exec": "~/.config/omarchy/bar/scripts/herdr-attention",
          "id": "herdr-attention",
          "interval": 10,
          "onClick": "omarchy-launch-terminal herdr",
          "tooltip": "Agentes de herdr",
          "type": "command"
        }
      ],
      "left": [
        {
          "id": "omarchy.menu"
        },
        {
          "id": "omarchy.workspaces"
        }
      ],
      "right": [
        {
          "id": "omarchy.tray"
        },
        {
          "id": "superwhisper.panel"
        },
        {
          "id": "omarchy.keyboard-layout"
        },
        {
          "id": "omarchy.agents"
        },
        {
          "id": "omarchy.bluetooth"
        },
        {
          "id": "omarchy.network"
        },
        {
          "id": "omarchy.tailscale"
        },
        {
          "id": "omarchy.audio"
        },
        {
          "id": "omarchy.monitor"
        },
        {
          "id": "omarchy.power",
          "showPercentage": true
        }
      ],
      "tray": []
    },
    "position": "top"
  },
  "cloneSourceRestores": [
    "io.github.sirjul1337.lock-explorer",
    "savaf.media"
  ],
  "disabledPlugins": [
    "omarchy.lock",
    "omarchy.media"
  ],
  "dock": {
    "pinned": [
      "org.gnome.Nautilus",
      "brave-browser",
      "foot",
      "obsidian",
      "Discord",
      "steam"
    ],
    "position": "bottom"
  },
  "idle": {
    "lock": 300,
    "screensaver": 150
  },
  "plugins": [
    {
      "design": "sheet",
      "id": "io.github.sirjul1337.lock-explorer"
    }
  ],
  "version": 1
}
