#!/bin/bash
# Devuelve el RGB al color del tema recién aplicado.
# La lógica vive en ~/.local/bin/rgb; esto es solo el enganche de Omarchy.
# En segundo plano porque openrgb re-detecta todo el hardware y tarda varios
# segundos: no queremos que el cambio de tema se quede colgado esperándolo.
"$HOME/.local/bin/rgb" theme >/dev/null 2>&1 &
