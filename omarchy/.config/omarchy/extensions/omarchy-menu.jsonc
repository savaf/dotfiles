{
  // Apaga/enciende todo el RGB de un tirón. Va bajo "Appearance" porque es donde
  // Omarchy pone los toggles de apariencia (cf. appearance.top-bar.background.*).
  // El ✓ aparece cuando está apagado.
  "appearance.rgb": {
    "icon": "󰌵",
    "label": "RGB",
    "aliases": ["rgb", "lights", "luces"],
    "description": "Apagar los LEDs o devolverlos al color del tema",
    "action": "$HOME/.local/bin/rgb toggle",
    "checked": "test -e \"${XDG_RUNTIME_DIR:-/tmp}/omarchy-rgb-off\""
  },

  // Va bajo "System" junto a Reboot/Shutdown. Arranca Windows una sola vez
  // (one-shot vía efibootmgr --bootnext); el reinicio siguiente vuelve solo a
  // Omarchy. Ver el propio script para el porqué de activar la entrada UEFI.
  "system.reboot_windows": {
    "icon": "",
    "label": "Reboot to Windows",
    "aliases": ["windows", "dualboot", "bootwindows"],
    "description": "Arranca Windows una vez, sin tocar el orden de arranque",
    "action": "$HOME/.local/bin/reboot-windows"
  },

  // Va bajo "System". Abre los workspaces de trabajo (`hw`, función de zsh
  // definida en zsh/.config/zsh/functions.zsh) en una terminal nueva. Sin atajo.
  "system.hw": {
    "icon": "󰆍",
    "label": "Work workspaces",
    "aliases": ["work", "workspaces", "herdr"],
    "description": "Abre los workspaces de trabajo (hw) en una terminal nueva",
    "action": "omarchy-launch-terminal zsh -ic hw"
  }
}
