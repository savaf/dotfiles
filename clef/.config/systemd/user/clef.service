# Proxy del socket: arrastra a clef-server y se cierra tras 5 min sin conexiones,
# lo que para también a clef-server (StopWhenUnneeded).
[Unit]
Description=Clef-Flash (Motor de decisiones) — proxy
Requires=clef-server.service
After=clef-server.service

[Service]
ExecStart=/usr/lib/systemd/systemd-socket-proxyd --exit-idle-time=300s 127.0.0.1:8771
