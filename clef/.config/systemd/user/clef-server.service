# llama-server with Clef-Flash; sleeps (unloads the model) after 2 min idle.
[Unit]
Description=Clef-Flash (decision engine) — llama-server
StopWhenUnneeded=yes

[Service]
ExecStart=%h/.local/bin/clef-server
# llama-server opens the port before loading the model and does not notify systemd:
# wait for /health 200 so the proxy does not forward the request too early.
ExecStartPost=/bin/sh -c 'until curl -sf -o /dev/null http://127.0.0.1:8771/health; do sleep 0.2; done'
TimeoutStartSec=60
