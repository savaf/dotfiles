#!/usr/bin/env node
// Resume el registro del Modo sombra (~/.local/state/decisiones/*.jsonl):
// por Decisión, cuántas hubo, quién decidió y qué opciones salieron.
// Sirve para saber cuándo hay volumen para etiquetar la muestra (docs/decisiones.md).
import { readdirSync, readFileSync } from 'node:fs';
import os from 'node:os';
import path from 'node:path';

const dir = path.join(os.homedir(), '.local/state/decisiones');
const rows = readdirSync(dir).filter((f) => f.endsWith('.jsonl'))
    .flatMap((f) => readFileSync(path.join(dir, f), 'utf8').split('\n').filter(Boolean).map((l) => JSON.parse(l)));
const by = Object.groupBy(rows, (r) => r.decision);
for (const [d, rs] of Object.entries(by)) {
    const count = (fn) => rs.filter(fn).length;
    const opts = Object.entries(Object.groupBy(rs.filter((r) => r.final), (r) => r.final))
        .map(([k, v]) => `${k} ${v.length}`).join(', ');
    console.log(`${d}: ${rs.length} | motor ${count((r) => r.motor && !r.respaldo)}`
        + ` · respaldo ${count((r) => r.respaldo)} · error ${count((r) => r.error)} | ${opts}`);
}
