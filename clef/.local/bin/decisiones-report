#!/usr/bin/env node
// Summarises the shadow-mode log (~/.local/state/decisiones/*.jsonl):
// per Decision, how many there were, who decided, and which options came out.
// Tells you when there is enough volume to label the sample (docs/decision-engine.md).
import { readdirSync, readFileSync } from 'node:fs';
import os from 'node:os';
import path from 'node:path';
import { summarize } from './decisiones-summary.mjs';

const dir = path.join(os.homedir(), '.local/state/decisiones');
const rows = readdirSync(dir).filter((f) => f.endsWith('.jsonl'))
    .flatMap((f) => readFileSync(path.join(dir, f), 'utf8').split('\n').filter(Boolean).map((l) => JSON.parse(l)));
for (const line of summarize(rows)) console.log(line);
