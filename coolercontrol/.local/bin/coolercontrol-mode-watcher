#!/bin/bash
# Cambia el modo activo de CoolerControl entre "Silencio" y "Rendimiento" según
# si hay alguna ventana de Hyprland cuya clase esté en gaming-classes.conf.
#
# Sin estado propio a propósito: en cada evento de ventana relee TODAS las
# ventanas abiertas (hyprctl clients) en vez de llevar un mapa dirección→clase,
# porque el evento closewindow>> de Hyprland solo trae la dirección (nunca la
# clase) — un mapa en memoria se desincroniza en cuanto se pierde un evento o
# se reinicia este servicio. El coste extra de un hyprctl por evento es
# despreciable.

set -uo pipefail

CC_URL="http://127.0.0.1:11987"
CC_TOKEN_FILE="${XDG_STATE_HOME:-$HOME/.local/state}/coolercontrol-modes/api-token"
CLASSES_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/coolercontrol-modes/gaming-classes.conf"
MODE_IDLE="Silencio"
MODE_GAMING="Rendimiento"
MODE_HOT="Ultra"
HOT_ON="${HOT_ON:-85}"    # °C (máx de GPU/CPU) a partir de los que, en auto, sube a Ultra
HOT_OFF="${HOT_OFF:-78}"   # °C por debajo de los que vuelve; la banda evita oscilar en el umbral
HOT_FILE="${XDG_RUNTIME_DIR:-/tmp}/coolercontrol-mode-watcher.hot"
POLL_SECS=5
CHOICE_FILE="${XDG_STATE_HOME:-$HOME/.local/state}/coolercontrol-modes/manual-mode"

log() { echo "[coolercontrol-mode-watcher] $*" >&2; }

if [[ ! -s "$CC_TOKEN_FILE" ]]; then
  log "falta el token en ${CC_TOKEN_FILE}; saliendo"
  exit 1
fi
TOKEN="$(<"$CC_TOKEN_FILE")"

# A propósito SIN abortar en error: un timeout puntual del daemon (ya visto en
# los logs con liquidctl) no debe tumbar el watcher, solo se reintenta en el
# siguiente evento de ventana.
cc_api() {
  curl -sS -m 10 -H "Authorization: Bearer ${TOKEN}" -H 'Content-Type: application/json' \
    -X "$1" "${CC_URL}${2}" ${3:+-d "$3"} 2>/dev/null
}

resolve_mode_uid() {  # resolve_mode_uid NOMBRE
  jq -r --arg n "$1" '.modes[]? | select(.name==$n) | .uid' <<<"$(cc_api GET /modes)" 2>/dev/null | head -1
}

UID_IDLE="$(resolve_mode_uid "$MODE_IDLE")"
UID_GAMING="$(resolve_mode_uid "$MODE_GAMING")"
UID_HOT="$(resolve_mode_uid "$MODE_HOT")"   # opcional: sin Ultra no hay subida por calor

if [[ -z "$UID_IDLE" || -z "$UID_GAMING" ]]; then
  log "faltan los modos '${MODE_IDLE}'/'${MODE_GAMING}'; aprovisionando…"
  "$(dirname "$0")/coolercontrol-provision" || { log "aprovisionamiento falló; saliendo"; exit 1; }
  UID_IDLE="$(resolve_mode_uid "$MODE_IDLE")"
  UID_GAMING="$(resolve_mode_uid "$MODE_GAMING")"
  [[ -n "$UID_IDLE" && -n "$UID_GAMING" ]] || { log "los modos siguen sin existir; saliendo"; exit 1; }
fi
log "modos resueltos: ${MODE_IDLE}=${UID_IDLE} ${MODE_GAMING}=${UID_GAMING}"

# Temperatura máxima (°C entera) entre GPU y CPU; vacío si no se pudo leer.
max_temp() {
  local g c hw
  g="$(timeout 5 nvidia-smi --query-gpu=temperature.gpu --format=csv,noheader 2>/dev/null | head -1)"
  for hw in /sys/class/hwmon/hwmon*; do
    [[ "$(cat "$hw/name" 2>/dev/null)" == coretemp ]] && { c="$(( $(cat "$hw/temp1_input" 2>/dev/null || echo 0) / 1000 ))"; break; }
  done
  printf '%s\n' "${g:-0}" "${c:-0}" | sort -n | tail -1
}

# ¿Está "caliente"? Con histéresis: se enciende a HOT_ON y se apaga bajo HOT_OFF.
# El estado vive en un fichero (no en memoria) por la misma razón que el resto:
# lo comparten el hilo de eventos y el de sondeo, y sobrevive a un reinicio.
is_hot() {
  local t
  t="$(max_temp)"
  [[ "$t" =~ ^[0-9]+$ ]] || { [[ -e "$HOT_FILE" ]]; return; }
  if (( t >= HOT_ON )); then : >"$HOT_FILE"
  elif (( t < HOT_OFF )); then rm -f "$HOT_FILE"; fi
  [[ -e "$HOT_FILE" ]]
}

# ¿Hay alguna ventana abierta cuya class/initialClass matchee un patrón (glob)
# de gaming-classes.conf? Se relee el fichero en cada llamada: así añadir un
# juego no requiere reiniciar el servicio.
any_game_open() {
  local patterns classes cls pat
  patterns="$(sed 's/#.*//' "$CLASSES_FILE" 2>/dev/null | grep -v '^[[:space:]]*$')"
  [[ -n "$patterns" ]] || return 1
  classes="$(hyprctl clients -j 2>/dev/null | jq -r '.[] | .class, .initialClass' 2>/dev/null)"
  while IFS= read -r cls; do
    [[ -n "$cls" ]] || continue
    while IFS= read -r pat; do
      [[ -n "$pat" ]] || continue
      # shellcheck disable=SC2053
      [[ "$cls" == $pat ]] && return 0
    done <<<"$patterns"
  done <<<"$classes"
  return 1
}

reconcile() {
  local want cur choice manual
  want="$UID_IDLE"
  any_game_open && want="$UID_GAMING"
  # Elección manual (coolercontrol-mode): manda sobre la detección de juegos.
  choice="$(cat "$CHOICE_FILE" 2>/dev/null)"
  if [[ -n "${choice:-}" && "$choice" != auto ]]; then
    manual="$(resolve_mode_uid "${choice^}")"
    [[ -n "$manual" ]] && want="$manual"
  fi
  # En auto, el calor extremo manda sobre todo lo demás (no sobre la elección manual).
  if [[ -z "${choice:-}" || "$choice" == auto ]] && [[ -n "$UID_HOT" ]] && is_hot; then
    want="$UID_HOT"
  fi
  cur="$(jq -r '.current_mode_uid // empty' <<<"$(cc_api GET /modes-active)" 2>/dev/null)"
  [[ -n "$cur" && "$cur" == "$want" ]] && return 0
  cc_api POST "/modes-active/${want}" >/dev/null
  case "$want" in
    "$UID_HOT")    log "temperatura >= ${HOT_ON} °C → modo ${MODE_HOT}" ;;
    "$UID_GAMING") log "juego detectado → modo ${MODE_GAMING}" ;;
    *)             log "sin juegos detectados → modo ${MODE_IDLE}" ;;
  esac
}

revert_on_exit() {
  [[ -n "${POLL_PID:-}" ]] && kill "$POLL_PID" 2>/dev/null
  rm -f "$HOT_FILE"
  log "parando: forzando modo ${MODE_IDLE}"
  cc_api POST "/modes-active/${UID_IDLE}" >/dev/null
}
trap revert_on_exit EXIT

SOCK="$(ls "${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"/hypr/*/.socket2.sock 2>/dev/null | head -1)"
if [[ -z "$SOCK" ]]; then
  log "no encontré el socket de eventos de Hyprland (\$XDG_RUNTIME_DIR/hypr/*/.socket2.sock)"
  exit 1
fi

rm -f "$HOT_FILE"
reconcile   # cubre arrancar/reiniciar con un juego ya abierto

# Sondeo de temperatura: los eventos de ventana no avisan de que algo se calienta.
[[ -n "$UID_HOT" ]] && { while sleep "$POLL_SECS"; do reconcile; done; } &
POLL_PID=$!

# Debounce: coalescer ráfagas de eventos (varias ventanas al lanzar un juego)
# en como mucho una reconciliación por segundo.
last=0
socat -u UNIX-CONNECT:"$SOCK" - | while IFS= read -r line; do
  case "$line" in
    openwindow\>\>*|closewindow\>\>*)
      now="$(date +%s)"
      if (( now - last >= 1 )); then
        reconcile
        last="$now"
      fi
      ;;
  esac
done
