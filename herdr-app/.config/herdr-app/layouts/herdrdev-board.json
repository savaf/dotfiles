{
  "id": "root", "type": "column", "titlebar": "none", "theme": "graphite", "preview": "mods/herdrdev-board/preview.svg",
  "ui_font": "Geist", "font_size": 13, "background": "#131619",
  "colors": { "background": "#17191c", "foreground": "#e6e7e9", "border": "#2a2d32", "accent": "#8b7df0" },
  "terminal_padding": [12, 10], "gap": 0, "resizable": false,
  "children": [
    { "id": "board-header", "type": "block", "size": { "px": 100 }, "window_drag": true, "content": { "mod": "herdrdev-board", "props": { "role": "header" } } },
    { "id": "board-cards", "type": "block", "size": { "px": 355 }, "border": { "width": 1, "color": "#2a2d32" }, "content": { "mod": "herdrdev-board" } },
    { "id": "workspace", "type": "column", "padding": [14, 24], "gap": 0, "resizable": false, "children": [
      { "id": "workspace-title", "type": "block", "size": { "px": 34 }, "background": "#17191c", "radius": 7, "content": { "mod": "herdrdev-board", "props": { "role": "terminals" } } },
      { "id": "live-terminals", "type": "block", "background": "#17191c", "content": { "tab": "active", "pane": {
        "gap": 12, "radius": 7, "background": "#17191c", "lone": true,
        "border": { "width": 1, "color": "#2a2d32" }, "focus": { "width": 1, "color": "#5b50b5" },
        "header": { "content": { "mod": "herdrdev-board", "props": { "role": "pane" } }, "height": 28, "position": "top", "reveal": "always" }
      } } }
    ] }
  ]
}
