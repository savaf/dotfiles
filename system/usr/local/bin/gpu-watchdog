#!/usr/bin/env bash
# Detecta un cuelgue de la GPU NVIDIA y deja evidencia antes de que haya que cortar la energía.
# Fase 1 (decisión de la política de recuperación): observar, nunca reiniciar ni resetear.
#
# Señales (basta una):
#  - `nvidia-smi` falla o excede el timeout dos veces seguidas, separadas CONFIRM_DELAY s.
#  - coolercontrold registra "stopped answering" (el único rastro del cuelgue del 2026-11-11:
#    el kernel no escribió ningún Xid).
# Al detectar: línea `crit` en el journal (se sincroniza al instante), instantánea con sync en
# STATE_DIR y notificación al usuario. Una sola vez por episodio.
#
# Variables (solo para pruebas): INTERVAL, CONFIRM_DELAY, STATE_DIR, JOURNAL_CMD, NVIDIA_SMI.

set -uo pipefail

INTERVAL="${INTERVAL:-15}"
CONFIRM_DELAY="${CONFIRM_DELAY:-30}"
STATE_DIR="${STATE_DIR:-/var/log/gpu-watchdog}"
NVIDIA_SMI="${NVIDIA_SMI:-nvidia-smi}"
JOURNAL_CMD="${JOURNAL_CMD:-journalctl -f -n 0 -o cat -u coolercontrold}"
KEEP=10
FLAG="$(mktemp -u /tmp/gpu-watchdog.XXXXXX)"
triggered=0

log() { echo "[gpu-watchdog] $*" >&2; }

gpu_ok() { timeout 10 "$NVIDIA_SMI" -L >/dev/null 2>&1; }

snapshot() {  # snapshot MOTIVO -> imprime el directorio creado
  local dir
  dir="${STATE_DIR}/$(date +%Y%m%d-%H%M%S)"
  mkdir -p "$dir"
  chmod 700 "$STATE_DIR" "$dir" 2>/dev/null
  { echo "motivo: $1"; date -Is; uptime; } >"$dir/resumen.txt"
  timeout 10 journalctl -n 200 --no-pager >"$dir/journal.txt" 2>&1
  timeout 10 "$NVIDIA_SMI" -q >"$dir/nvidia-smi-q.txt" 2>&1
  timeout 5 sensors >"$dir/sensors.txt" 2>&1
  timeout 5 sh -c 'fuser -v /dev/nvidia* 2>&1' >"$dir/usuarios-gpu.txt" 2>&1
  sync
  # Conserva solo las últimas KEEP instantáneas.
  # shellcheck disable=SC2012
  ls -1dt "${STATE_DIR}"/*/ 2>/dev/null | tail -n +$((KEEP + 1)) | xargs -r rm -rf
  echo "$dir"
}

notify_user() {
  local user uid
  user="$(id -nu 1000 2>/dev/null)" || return 0
  uid="$(id -u "$user")"
  runuser -u "$user" -- env DBUS_SESSION_BUS_ADDRESS="unix:path=/run/user/${uid}/bus" \
    notify-send -u critical "GPU colgada" "$1" 2>/dev/null || true
}

trigger() {  # trigger MOTIVO
  ((triggered)) && return 0
  triggered=1
  local dir
  logger -p user.crit -t gpu-watchdog "GPU colgada: $1"
  dir="$(snapshot "$1")"
  logger -p user.crit -t gpu-watchdog "instantánea en ${dir}"
  notify_user "$1. Apaga limpio: Alt+Impr Pant + R E I S U B. Instantánea: ${dir}"
}

cleanup() {
  [[ -n "${READER_PID:-}" ]] && kill "$READER_PID" 2>/dev/null
  rm -f "$FLAG"
}
trap cleanup EXIT

# Lector del journal de coolercontrold: marca el fichero cuando ve el aviso.
(
  eval "$JOURNAL_CMD" 2>/dev/null | while IFS= read -r line; do
    [[ "$line" == *"stopped answering"* ]] && : >"$FLAG"
  done
) &
READER_PID=$!

log "vigilando la GPU cada ${INTERVAL} s"
while sleep "$INTERVAL"; do
  if [[ -e "$FLAG" ]]; then
    rm -f "$FLAG"
    trigger "coolercontrold informa que la GPU dejó de responder"
  fi
  if gpu_ok; then
    triggered=0
  else
    sleep "$CONFIRM_DELAY"
    gpu_ok || trigger "nvidia-smi no responde (dos intentos)"
  fi
done
